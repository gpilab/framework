#!/usr/bin/env bash

BASEDIR=$(python -c 'import gpi_core; import os; p = print(os.path.dirname(gpi_core.__file__))')
cd $BASEDIR
gpi_make --all --force -w
file=~/.gpirc
if [ -f "$file" ]; then
    conf=$(cat $file)
    paths=$(awk '/^LIB_DIRS/{print $3}' $file)
    IFS=':' read -r -a array <<< "$paths"
    for path in "${array[@]}"
    do
        if [ -d "$path" ]; then
            echo "Building modules in: $path"
            cd $path
            gpi_make --all --force -r 10 -w
        else
            echo "Warning: Directory '$path' does not exist, skipping."
        fi
    done
fi