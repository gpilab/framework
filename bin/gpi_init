#!/usr/bin/env bash

BASEDIR=$(python -c 'import gpi_core; import os; print(os.path.dirname(gpi_core.__file__))')
ROOTDIR=$(dirname "$BASEDIR")

_build_dir() {
    target="$1"
    depth="$2"
    if [ -d "$target" ]; then
        echo "Building modules in: $target"
        cd "$target" || return
        gpi_make --all --force -r "$depth" -w
    fi
}

# Ensure torch has working CUDA support if an NVIDIA GPU is present
python -m gpi.torch_cuda_setup

# Core GPI native modules
_build_dir "$BASEDIR" 10

# PyFI modules (editable/source checkout or installed layout)
_build_dir "$ROOTDIR/gpi/include/PyFI" 2
_build_dir "$ROOTDIR/include/PyFI" 2

while IFS= read -r path; do
    bname=$(basename "$path")
    if [ "$bname" = "gpi_core" ] || [ "$bname" = "PyFI" ] || [[ "$bname" == gpi_* ]]; then
        _build_dir "$path" 10
    else
        echo "Skipping non-GPI path: $path"
    fi
done < <(python -c "
import sys, io
_o = sys.stdout; sys.stdout = io.StringIO()
from gpi.config import Config
sys.stdout = _o
for p in Config.GPI_NODE_BUILD_DIRS:
    print(p)
" 2>/dev/null)

python -m gpi.install_shortcut --interactive