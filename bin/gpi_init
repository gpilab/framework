#!/usr/bin/env bash

BASEDIR=$(python -c 'import gpi_core; import os; print(os.path.dirname(gpi_core.__file__))')
cd "$BASEDIR"
gpi_make --all --force -w

while IFS= read -r path; do
    if [ -d "$path" ]; then
        echo "Building modules in: $path"
        cd "$path"
        gpi_make --all --force -r 10 -w
    else
        echo "Warning: Directory '$path' does not exist, skipping."
    fi
done < <(python -c "
import sys, io
_o = sys.stdout; sys.stdout = io.StringIO()
from gpi.config import Config
sys.stdout = _o
for p in Config.GPI_NODE_BUILD_DIRS:
    print(p)
" 2>/dev/null)

python -m gpi.install_shortcut --interactive