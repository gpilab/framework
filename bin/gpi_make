import sys, os, sysconfig


def _repair_legacy_sitepackages_gpi_dir():
    """Move legacy runtime settings out of site-packages/gpi.

    A plain directory at site-packages/gpi (without __init__.py) is treated as
    a namespace package and can shadow the real editable gpi package.
    """
    sp = sysconfig.get_paths().get('purelib', '')
    legacy_dir = os.path.join(sp, 'gpi')
    legacy_init = os.path.join(legacy_dir, '__init__.py')
    if not os.path.isdir(legacy_dir) or os.path.isfile(legacy_init):
        return

    legacy_settings = os.path.join(legacy_dir, 'gpi_settings.json')
    appdata = os.environ.get('APPDATA')
    cfg_dir = os.path.join(appdata, 'gpi') if appdata else os.path.join(os.path.expanduser('~'), '.gpi')
    cfg_settings = os.path.join(cfg_dir, 'gpi_settings.json')

    try:
        os.makedirs(cfg_dir, exist_ok=True)
        if os.path.isfile(legacy_settings) and not os.path.isfile(cfg_settings):
            with open(legacy_settings, 'r') as src, open(cfg_settings, 'w') as dst:
                dst.write(src.read())
    except OSError:
        pass

    # Remove the legacy namespace directory if possible.
    try:
        for name in os.listdir(legacy_dir):
            path = os.path.join(legacy_dir, name)
            if os.path.isfile(path):
                os.remove(path)
        os.rmdir(legacy_dir)
    except OSError:
        # If something else is using the folder, keep going; imports may still work
        # when launched from a source checkout root.
        pass


_repair_legacy_sitepackages_gpi_dir()

# Check for Anaconda PREFIX, or assume that THIS file location is the CWD.
GPI_PREFIX = '/opt/anaconda1anaconda2anaconda3' # ANACONDA
if GPI_PREFIX == '/opt/'+'anaconda1anaconda2anaconda3':
    # Prefer the active conda/venv environment so Library/include paths resolve correctly
    conda_prefix = os.environ.get('CONDA_PREFIX') or os.environ.get('VIRTUAL_ENV')
    if conda_prefix:
        GPI_PREFIX = conda_prefix
    else:
        GPI_PREFIX, _ = os.path.split(os.path.dirname(os.path.realpath(__file__)))
    GPI_LIB_DIR = os.path.join(GPI_PREFIX, 'lib')
    if GPI_LIB_DIR not in sys.path:
        sys.path.insert(0, GPI_LIB_DIR)

# gpi
from gpi import make
from gpi import make_pybind11

if __name__ == '__main__':
    # Store original sys.argv and working directory
    original_argv = sys.argv.copy()
    original_cwd = os.getcwd()
    
    # Initialize return codes
    retcode1 = 0  # Default success since standard make is commented out
    retcode2 = 0  # Default success for make_pybind11
    
    # Standard make is commented out, so retcode1 stays 0
    # First run the standard make for PyMOD files
    print("Running standard make for PyMOD files...")
    sys.argv = original_argv.copy()  # Restore original arguments
    
    try:
        retcode1 = make.make(GPI_PREFIX)
    except SystemExit as e:
        retcode1 = e.code if e.code is not None else 0
        print(f"Standard make exited with code: {retcode1}")
    except Exception as e:
        print(f"Standard make failed with exception: {e}")
        retcode1 = 1
    finally:
        # Restore working directory after make.make() which may have changed it
        os.chdir(original_cwd)
    
    # Then run make_pybind11 for PYBIND11 files
    #print("\nRunning make_pybind11 for PYBIND11 files...")
    sys.argv = original_argv.copy()  # Restore original arguments for make_pybind11
    
    try:
        retcode2 = make_pybind11.make(GPI_PREFIX)
    except SystemExit as e:
        retcode2 = e.code if e.code is not None else 0
        print(f"make_pybind11 exited with code: {retcode2}")
    except Exception as e:
        print(f"make_pybind11 failed with exception: {e}")
        retcode2 = 1
    
    # Exit with error if either failed
    if retcode1 != 0 or retcode2 != 0:
        sys.exit(1)
    else:
        sys.exit(0)